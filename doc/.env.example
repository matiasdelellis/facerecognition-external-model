# Example environment file for docker-compose.
#
# Copy this file to `../.env` (the repo root) and fill in real values.
# `../.env` is gitignored — never commit it.
#
# docker-compose reads this file via `env_file:` and exports each variable
# into the container, where the application picks them up from `os.environ`.
# Any variable not set here falls back to the value baked into the Dockerfile
# (see the `ENV` directives in docker/Dockerfile).

# Shared secret for the x-api-key header. Generate a fresh one with:
#   openssl rand -base64 32
API_KEY=some-super-secret-api-key

# Detection algorithm: 1 (CNN), 3 (HOG), or 4 (CNN validated against HOG).
# Default: 4
# FACE_MODEL=4

# Number of gunicorn worker processes. Each worker loads the dlib models
# into memory — raise only if the host has spare CPU cores and ~250 MB
# of RAM per worker.
# Default: 1
# GUNICORN_WORKERS=1

# Per-request gunicorn timeout, in seconds. Big images on slow CPUs can
# take several minutes with FACE_MODEL=4.
# Default: 300
# REQ_TIMEOUT=300
